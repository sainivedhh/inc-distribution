# Environment Configuration
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0
API_TOKEN=incubrix-demo-token-secret-xyz123
BASE_URL=http://localhost:8000

# Simulation Mode (runs all tests and pipelines without external accounts)
SIMULATION_MODE=true

# Database (PostgreSQL for production/docker, SQLite async for tests)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/distribution
# Or for local SQLite: sqlite+aiosqlite:///./distribution.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage (MinIO / S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=incubrix-distribution
S3_REGION=us-east-1

# Cryptography & Signing
SECRET_ENCRYPTION_KEY=k7R7E-N6yV6s1N3xK1P2l7-v5d_t0A1B2C3D4E5F6G8=
WEBHOOK_SIGNING_SECRET=incubrix-webhook-hmac-signing-secret-key-32chars

# Connectors Kill Switch (comma-separated list of disabled connector keys)
DISABLED_CONNECTORS=

# AI Provider ("mock" or "gemini")
AI_PROVIDER=mock
AI_API_KEY=
